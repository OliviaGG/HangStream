# Discord Bot Configuration
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-client-id-here
DISCORD_GUILD_ID=your-guild-id-here

# Channel IDs
GAME_CHANNEL_ID=channel-id-for-game-commands
ANNOUNCEMENTS_CHANNEL_ID=channel-id-for-ticker-events

# Server URLs
CHAT_RELAY_URL=http://localhost:3000
GAME_SERVER_URL=http://localhost:3020
HANGSTREAM_API_SECRET=shared-secret-used-by-hangstream

# Discord server invite link (for !discord command)
DISCORD_INVITE_URL=https://discord.gg/your-invite-link
