{
  "name": "hangstream",
  "version": "0.1.0",
  "description": "HangStream — WebSocket multiplayer demo",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "azure-start": "node server/server.js",
    "test": "node --test server/__tests__/games.test.js server/__tests__/game-vote.test.js server/__tests__/word-bank.test.js server/__tests__/storage.test.js server/__tests__/oauth-state.test.js",
    "smoke": "node server/__tests__/smoke.js",
    "smoke:vote-ui": "node server/__tests__/vote-ui.smoke.js",
    "smoke:games": "node server/__tests__/games-live.js && node server/__tests__/games-chat.js",
    "build:word-bank": "node server/games/tools/build-curated-words.js",
    "deploy-azure": "powershell -ExecutionPolicy Bypass -File deploy-azure.ps1"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "nodemailer": "^10.2.0",
    "sqlite3": "^6.0.1",
    "stripe": "^14.25.0",
    "tiktok-live-connector": "^2.5.0",
    "tmi.js": "^1.8.5",
    "ws": "^8.13.0"
  }
}
